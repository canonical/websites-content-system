{
  "name": "websites-content-system",
  "version": "1.12.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:canonical/cs.canonical.com.git"
  },
  "author": "Canonical Webteam",
  "license": "MIT",
  "scripts": {
    "build": "yarn run build-js && yarn run build-css",
    "build-css": "sass static/client/App.scss static/build/styles.css --load-path=node_modules --style=compressed && postcss --map false --use autoprefixer --replace 'static/build/**/*.css'",
    "build-js": "npx vite build",
    "lint": "npmPkgJsonLint . && tsc && eslint . --ext .ts,.tsx",
    "serve": "./entrypoint 0.0.0.0:${PORT}",
    "start": "yarn run build && concurrently --raw 'yarn run watch' 'yarn run serve'",
    "test-js": "vitest",
    "test-python": "pytest webapp/tests",
    "watch": "watch -p 'static/client/**/*.{js,jsx,ts,tsx,scss}' -c 'yarn run build'",
    "dev": "vite",
    "lint-python": "flake8 webapp tests && black --check --line-length 79 webapp tests",
    "format-python": "black --line-length 79 webapp tests",
    "prepare": "husky",
    "test-e2e": "playwright test"
  },
  "dependencies": {
    "@canonical/react-components": "3.12.1",
    "axios": "1.12.2",
    "classnames": "2.5.1",
    "formik": "2.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-query": "3.39.3",
    "react-router-dom": "6.29.0",
    "vanilla-framework": "4.41.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@canonical/typescript-config-react": "0.10.0-experimental.4",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@playwright/test": "1.50.1",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "14.3.1",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-c8": "0.33.0",
    "autoprefixer": "10.4.21",
    "concurrently": "8.2.2",
    "dotenv": "16.4.7",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-config-react-app": "7.0.1",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-react": "7.37.5",
    "husky": "9.1.7",
    "jsdom": "21.1.2",
    "npm-package-json-lint": "8.0.0",
    "pinst": "3.0.0",
    "postcss": "8.5.6",
    "postcss-cli": "10.1.0",
    "prettier": "3.4.2",
    "sass": "1.83.4",
    "sass-loader": "13.3.3",
    "stylelint": "15.11.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-standard": "32.0.0",
    "stylelint-config-standard-scss": "7.0.1",
    "stylelint-order": "6.0.4",
    "stylelint-prettier": "3.0.0",
    "stylelint-scss": "4.7.0",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "unplugin-auto-import": "0.19.0",
    "vite": "5.4.20",
    "vitest": "3.2.6",
    "watch-cli": "0.2.3"
  },
  "npmpackagejsonlint": {
    "rules": {
      "prefer-absolute-version-dependencies": "error",
      "prefer-absolute-version-devDependencies": "error",
      "prefer-alphabetical-dependencies": "error",
      "prefer-alphabetical-devDependencies": "error"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.52.4"
  }
}
